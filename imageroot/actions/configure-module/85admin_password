# A new administrator password, set on the running server. It goes to
# zmprov on its standard input: never on a command line, never in a log.

import os
import sys

import agent
import carbonio

pending = "admin-password.pending"
if not os.path.exists(pending):
    sys.exit(0)
try:
    with open(pending) as fpw:
        password = fpw.read().strip()
    account = f"{carbonio.env('CARBONIO_ADMIN_USER', 'admin')}@{carbonio.env('CARBONIO_MAIL_DOMAIN')}"
    proc = carbonio.podman_exec(["su", "-", "zextras", "-c", "zmprov -l"], stdin=f"sp {account} {password}\n", check=False)
    agent.assert_exp(proc.returncode == 0, f"Cannot set the password of {account}")
finally:
    os.unlink(pending)
