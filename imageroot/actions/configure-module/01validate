import json
import os
import sys

import agent
import carbonio

agent.set_weight(os.path.basename(__file__), 0)  # Validation step, no task progress

request = json.load(sys.stdin)
errors = []


def fail(field, value, error):
    errors.append({"field": field, "parameter": field, "value": value, "error": error})


env = carbonio.env
initialized = carbonio.initialized()
host = request["host"].lower()
current_role = carbonio.cluster_role()
role = request.get("cluster_role", current_role)

if host != env("TRAEFIK_HOST") and agent.http_route_in_use(domain=host):
    fail("host", host, "domain_already_used_in_traefik")
if initialized and env("CARBONIO_HOSTNAME") and host != env("CARBONIO_HOSTNAME"):
    # The server name is written in the directory and in every account
    fail("host", host, "host_cannot_change")

admin_host = request.get("admin_host", env("CARBONIO_ADMIN_HOSTNAME")).lower()
if admin_host:
    if admin_host == host:
        fail("admin_host", admin_host, "admin_host_is_host")
    elif admin_host != env("CARBONIO_ADMIN_HOSTNAME") and agent.http_route_in_use(domain=admin_host):
        fail("admin_host", admin_host, "domain_already_used_in_traefik")

# Roles: standalone and master differ only in what they publish; a worker
# holds data of another directory and cannot become something else.
if initialized and role != current_role and "worker" in (role, current_role):
    fail("cluster_role", role, "cluster_role_cannot_change")

if role == "worker":
    join = request.get("join", env("CARBONIO_JOIN"))
    if not join:
        fail("join", join, "join_required")
    elif initialized and join != env("CARBONIO_JOIN"):
        fail("join", join, "join_cannot_change")
    elif not initialized:
        master = next((m for m in carbonio.list_masters() if m["module_id"] == join), None)
        if master is None:
            fail("join", join, "join_not_found")
        elif master["release"] and master["release"] != env("CARBONIO_RELEASE"):
            fail("join", join, "join_release_mismatch")
else:
    if not initialized:
        if not request.get("admin_password") and not carbonio.read_secrets().get("CARBONIO_ADMIN_PASSWORD"):
            fail("admin_password", "", "admin_password_required")
    mail_domain = request.get("mail_domain", "")
    if initialized and mail_domain and mail_domain.lower() != env("CARBONIO_MAIL_DOMAIN"):
        fail("mail_domain", mail_domain, "mail_domain_cannot_change")

    # Public mail ports: one owner per node
    others = carbonio.mail_modules_on_node()
    if others:
        fail("cluster_role", ",".join(others), "mail_module_on_node")
    elif not carbonio.service_active():
        busy = [str(p) for p in carbonio.MAIL_PORTS if carbonio.port_in_use(p)]
        if busy:
            fail("cluster_role", ",".join(busy), "mail_port_in_use")

# Ports for the other servers, on the node WireGuard address
if not carbonio.service_active():
    vpn_ports = {"master": carbonio.MASTER_VPN_PORTS, "worker": carbonio.WORKER_VPN_PORTS}.get(role, [])
    busy = [str(p) for p in vpn_ports if carbonio.port_in_use(p)]
    if busy:
        fail("cluster_role", ",".join(busy), "cluster_port_in_use")

for feature, enabled in request.get("features", {}).items():
    if enabled:
        fail("features", feature, "feature_not_available_yet")

if errors:
    agent.set_status("validation-failed")
    json.dump(errors, fp=sys.stdout)
    sys.exit(3)
