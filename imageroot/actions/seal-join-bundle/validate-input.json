{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Seal the join bundle",
    "$id": "http://schema.nethserver.org/carbonio/seal-join-bundle-input.json",
    "type": "object",
    "required": ["public_key", "module_id"],
    "additionalProperties": false,
    "properties": {
        "public_key": {"type": "string", "description": "Ephemeral X25519 public key of the caller, base64", "pattern": "^[A-Za-z0-9+/]{43}=$"},
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*[0-9]+$"},
        "fqdn": {"type": "string"}
    }
}
